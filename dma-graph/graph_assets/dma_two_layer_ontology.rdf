<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://microsoft.com/ontology/dma-two-layer/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://microsoft.com/ontology/dma-two-layer/">

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Ontology Declaration                                                    -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <owl:Ontology rdf:about="http://microsoft.com/ontology/dma-two-layer/">
    <rdfs:label>DMA Two-Layer Supply Chain Intelligence Network</rdfs:label>
    <rdfs:comment>A two-layer ontology combining the operational supply chain (Layer 1: vendors, items, purchase orders, sales orders, inventory, customers) with a decision-trace intelligence layer (Layer 2: episodes, mitigation decisions, facts, reflections, concepts, policies, goals, recommendations). Cross-layer edges anchor institutional memory to specific supply chain entities, enabling the Disruption Mitigation Agent to retrieve prior context before evaluating new disruptions.</rdfs:comment>
  </owl:Ontology>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- LAYER 1 — Supply Chain Network (operational entities)                  -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <!-- ── Vendor ──────────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Vendor">
    <rdfs:label>Vendor</rdfs:label>
    <rdfs:comment>A supplier that can fulfil purchase orders for one or more items. Vendors are evaluated as alternates when the original supplier is disrupted.</rdfs:comment>
    <ont:icon>🏭</ont:icon>
    <ont:color>#1565C0</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/vendor_vendorId">
    <rdfs:label>vendorId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Unique vendor account number (e.g. 1001, 1002, 1003)</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/vendor_vendorName">
    <rdfs:label>vendorName</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/vendor_tier">
    <rdfs:label>tier</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Supply chain tier classification</rdfs:comment>
    <ont:propertyType>enum</ont:propertyType>
    <ont:enumValues>1,2,3</ont:enumValues>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/vendor_region">
    <rdfs:label>region</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/vendor_onHold">
    <rdfs:label>onHold</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Whether the vendor is on purchasing hold (infeasible for alternate vendor mitigation)</rdfs:comment>
    <ont:propertyType>boolean</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/vendor_generalLeadTime">
    <rdfs:label>generalLeadTime</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Default lead time in days (overridden by trade agreement lead time)</rdfs:comment>
    <ont:propertyType>integer</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── Item ────────────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Item">
    <rdfs:label>Item</rdfs:label>
    <rdfs:comment>A released product or material that can be sourced, stocked, and delivered. Items are the subjects of purchase orders and can have alternate substitutes.</rdfs:comment>
    <ont:icon>📦</ont:icon>
    <ont:color>#0288D1</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/item_itemId">
    <rdfs:label>itemId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Unique item number (e.g. DMA-MTR-DC, _DMA-SEAL-NBR)</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/item_description">
    <rdfs:label>description</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/item_safetyStockQty">
    <rdfs:label>safetyStockQty</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Minimum on-hand floor; drawing below this triggers a safety stock breach</rdfs:comment>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/item_isSingleSourced">
    <rdfs:label>isSingleSourced</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>True when only one vendor has a trade agreement for this item</rdfs:comment>
    <ont:propertyType>boolean</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/item_purchasePrice">
    <rdfs:label>purchasePrice</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Standard purchase price per unit</rdfs:comment>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── TradeAgreement ──────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/TradeAgreement">
    <rdfs:label>Trade Agreement</rdfs:label>
    <rdfs:comment>A PurchasePriceAgreement between a vendor and an item, defining price per unit, fixed charges, and lead time. Used to compute the incremental cost of switching to an alternate vendor.</rdfs:comment>
    <ont:icon>📋</ont:icon>
    <ont:color>#78909C</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/tradeagreement_taId">
    <rdfs:label>taId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/TradeAgreement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Trade agreement identifier (item-vendor pair key)</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/tradeagreement_pricePerUnit">
    <rdfs:label>pricePerUnit</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/TradeAgreement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/tradeagreement_fixedCharges">
    <rdfs:label>fixedCharges</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/TradeAgreement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>One-time fixed charge per order; can invert cost rankings at low quantities</rdfs:comment>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/tradeagreement_leadTimeDays">
    <rdfs:label>leadTimeDays</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/TradeAgreement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Vendor lead time for this item; determines Full vs Partial feasibility against PO delay</rdfs:comment>
    <ont:propertyType>integer</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── PurchaseOrderLine ────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine">
    <rdfs:label>Purchase Order Line</rdfs:label>
    <rdfs:comment>A single line on a purchase order representing a quantity of an item from a vendor. The entry point for every disruption — a delay or quantity shortfall on a PO line triggers DMA execution.</rdfs:comment>
    <ont:icon>🛒</ont:icon>
    <ont:color>#004D40</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/purchaseorderline_poId">
    <rdfs:label>poId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Purchase order identifier (e.g. PO-MOTR, _PO-SEAL)</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/purchaseorderline_orderedQty">
    <rdfs:label>orderedQty</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/purchaseorderline_delayDays">
    <rdfs:label>delayDays</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Number of days by which delivery is delayed; triggers Full/Partial classification</rdfs:comment>
    <ont:propertyType>integer</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/purchaseorderline_originalDeliveryDate">
    <rdfs:label>originalDeliveryDate</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <ont:propertyType>date</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/purchaseorderline_pricePerUnit">
    <rdfs:label>pricePerUnit</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── SalesOrder ──────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/SalesOrder">
    <rdfs:label>Sales Order</rdfs:label>
    <rdfs:comment>A customer demand commitment with a required receipt date. Pegged to purchase orders; the RequestedReceiptDate is the deadline used to classify mitigations as Full (on time) or Partial (late).</rdfs:comment>
    <ont:icon>📑</ont:icon>
    <ont:color>#2E7D32</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/salesorder_soId">
    <rdfs:label>soId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/SalesOrder"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Sales order identifier (e.g. SO-MOTR, SO-VLVE-9)</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/salesorder_orderedQty">
    <rdfs:label>orderedQty</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/SalesOrder"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/salesorder_requiredDate">
    <rdfs:label>requiredDate</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/SalesOrder"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment>RequestedReceiptDate — the SLA deadline used for Full/Partial classification</rdfs:comment>
    <ont:propertyType>date</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/salesorder_impactType">
    <rdfs:label>impactType</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/SalesOrder"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Pegging relationship type (Marking or Pegged)</rdfs:comment>
    <ont:propertyType>enum</ont:propertyType>
    <ont:enumValues>Marking,Pegged</ont:enumValues>
  </owl:DatatypeProperty>

  <!-- ── Inventory ───────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Inventory">
    <rdfs:label>Inventory</rdfs:label>
    <rdfs:comment>On-hand stock of an item at a warehouse. The safe draw quantity (onHand − safetyStock) determines how many units can be used without breaching the safety stock floor.</rdfs:comment>
    <ont:icon>🗄️</ont:icon>
    <ont:color>#388E3C</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/inventory_inventoryId">
    <rdfs:label>inventoryId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Inventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Composite key: itemId + warehouseId</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/inventory_onHandQty">
    <rdfs:label>onHandQty</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Inventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Available (uncommitted) on-hand quantity</rdfs:comment>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/inventory_safetyStockFloor">
    <rdfs:label>safetyStockFloor</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Inventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Minimum quantity that must remain after any draw; breach flags UseOnHand/AltItem as Partial</rdfs:comment>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/inventory_warehouseId">
    <rdfs:label>warehouseId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Inventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── Customer ────────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Customer">
    <rdfs:label>Customer</rdfs:label>
    <rdfs:comment>The downstream demand source for a sales order. Customer tier determines priority weighting when multiple sales orders compete for limited inventory.</rdfs:comment>
    <ont:icon>🏢</ont:icon>
    <ont:color>#F57F17</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/customer_customerId">
    <rdfs:label>customerId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/customer_customerName">
    <rdfs:label>customerName</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/customer_tier">
    <rdfs:label>tier</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Customer priority tier (1 = strategic, 2 = standard, 3 = transactional)</rdfs:comment>
    <ont:propertyType>enum</ont:propertyType>
    <ont:enumValues>1,2,3</ont:enumValues>
  </owl:DatatypeProperty>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- LAYER 2 — Intelligence / Memory Layer                                  -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <!-- ── Episode ─────────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Episode">
    <rdfs:label>Episode</rdfs:label>
    <rdfs:comment>A recorded DMA execution instance — one disruption event and its full resolution. Episodes are the primary memory unit: they capture the disruption context, link to all candidate mitigations evaluated, and chain temporally via NEXT edges.</rdfs:comment>
    <ont:icon>📖</ont:icon>
    <ont:color>#E65100</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/episode_episodeId">
    <rdfs:label>episodeId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Sequential episode identifier (e.g. EP-001 through EP-006)</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/episode_scenario">
    <rdfs:label>scenario</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Human-readable description of the disruption scenario</rdfs:comment>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/episode_disruptionType">
    <rdfs:label>disruptionType</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The nature of the disruption that triggered this episode</rdfs:comment>
    <ont:propertyType>enum</ont:propertyType>
    <ont:enumValues>DeliveryDelay,QuantityShortfall,Combined</ont:enumValues>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/episode_delayDays">
    <rdfs:label>delayDays</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <ont:propertyType>integer</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/episode_createdAt">
    <rdfs:label>createdAt</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <ont:propertyType>datetime</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── MitigationDecision ──────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/MitigationDecision">
    <rdfs:label>Mitigation Decision</rdfs:label>
    <rdfs:comment>A single candidate mitigation evaluated by the DMA for a disruption episode. Decisions are classified as Full (deadline met, no quantity shortfall), Partial (deadline or quantity unmet), or Baseline (AcceptDisruption). Full decisions are ranked by a 25/25/25/25 weighted score across cost, delay, quantity shortfall, and inventory depletion.</rdfs:comment>
    <ont:icon>⚖️</ont:icon>
    <ont:color>#BF360C</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_decisionId">
    <rdfs:label>decisionId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Decision identifier (e.g. DEC-001, DEC-006A)</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_mitigationType">
    <rdfs:label>mitigationType</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The mitigation strategy selected or evaluated</rdfs:comment>
    <ont:propertyType>enum</ont:propertyType>
    <ont:enumValues>AlternateVendor,AlternateItem,UseOnHandInventory,ExpeditedShipping,Combined,AcceptDisruption</ont:enumValues>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_feasibility">
    <rdfs:label>feasibility</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Full = deadline met, no shortfall; Partial = one constraint unmet; Baseline = AcceptDisruption</rdfs:comment>
    <ont:propertyType>enum</ont:propertyType>
    <ont:enumValues>Full,Partial,Baseline</ont:enumValues>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_totalMonetaryCost">
    <rdfs:label>totalMonetaryCost</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Incremental cost above original PO value: max(0, altTotal − origTotal)</rdfs:comment>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_delayDays">
    <rdfs:label>delayDays</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Residual delay after applying this mitigation</rdfs:comment>
    <ont:propertyType>integer</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_quantityShortfall">
    <rdfs:label>quantityShortfall</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Units unfulfilled after applying this mitigation (0 for Full decisions)</rdfs:comment>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_inventoryDepletion">
    <rdfs:label>inventoryDepletion</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Units drawn below safety stock floor; nonzero flags inventory_breached = true</rdfs:comment>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_totalScore">
    <rdfs:label>totalScore</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Min-max normalised composite score (0–1, lower is better) across Full decisions only</rdfs:comment>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_rank">
    <rdfs:label>rank</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Rank among Full decisions (1 = recommended); null for Partial and Baseline</rdfs:comment>
    <ont:propertyType>integer</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_vendorId">
    <rdfs:label>vendorId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>For AlternateVendor decisions: the selected vendor account number</rdfs:comment>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── Fact ────────────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Fact">
    <rdfs:label>Fact</rdfs:label>
    <rdfs:comment>An LLM-distilled atomic insight about a vendor, item, or disruption pattern. Facts are derived from episodes and used as retrieval anchors for future DMA runs. Example: "At 10-day delay, vendors 1001 and 1002 tie for _DMA-SEAL-NBR — cost-speed tradeoff."</rdfs:comment>
    <ont:icon>💡</ont:icon>
    <ont:color>#F9A825</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/fact_factId">
    <rdfs:label>factId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Fact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/fact_body">
    <rdfs:label>body</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Fact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The distilled insight text, written as an atomic, retrievable statement</rdfs:comment>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/fact_createdAt">
    <rdfs:label>createdAt</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Fact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <ont:propertyType>datetime</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── Reflection ──────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Reflection">
    <rdfs:label>Reflection</rdfs:label>
    <rdfs:comment>A higher-order pattern synthesised from one or more Facts. Reflections surface systemic risks and recurring dynamics that span multiple episodes. Example: "Safety-stock breach risk is concentrated in items with on-hand/floor ratios below 2x."</rdfs:comment>
    <ont:icon>🔍</ont:icon>
    <ont:color>#AB47BC</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/reflection_refId">
    <rdfs:label>refId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Reflection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/reflection_body">
    <rdfs:label>body</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Reflection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/reflection_actionable">
    <rdfs:label>actionable</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Reflection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>True when this reflection implies a concrete supply chain hardening action</rdfs:comment>
    <ont:propertyType>boolean</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── Concept ─────────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Concept">
    <rdfs:label>Concept</rdfs:label>
    <rdfs:comment>A thematic retrieval anchor that groups related episodes and facts. Concept-mediated traversal lets the DMA surface prior context by semantic theme (e.g. "safety_stock_erosion") rather than exact entity match, enabling cross-item and cross-vendor learning.</rdfs:comment>
    <ont:icon>🏷️</ont:icon>
    <ont:color>#7B1FA2</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/concept_label">
    <rdfs:label>label</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Concept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Slug-style concept name (e.g. alternate_vendor_switch, safety_stock_erosion)</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/concept_description">
    <rdfs:label>description</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Concept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── Policy ──────────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Policy">
    <rdfs:label>Policy</rdfs:label>
    <rdfs:comment>A business rule that constrains which mitigations are feasible. Policies are recorded on each MitigationDecision to explain why options were rejected (e.g. POL-ORIGVEND: cannot re-order from the original failing vendor; POL-ONHOLD: cannot order from a vendor on purchasing hold).</rdfs:comment>
    <ont:icon>📜</ont:icon>
    <ont:color>#546E7A</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/policy_policyId">
    <rdfs:label>policyId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Policy identifier (e.g. POL-ONHOLD, POL-ORIGVEND, POL-TACOST, POL-SODEADLINE)</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/policy_name">
    <rdfs:label>name</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/policy_infeasibilityReason">
    <rdfs:label>infeasibilityReason</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The infeasibility reason code this policy enforces (maps to DMA output schema)</rdfs:comment>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── Goal ────────────────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Goal">
    <rdfs:label>Goal</rdfs:label>
    <rdfs:comment>A scoring objective used to rank Full mitigations. The DMA uses four goals weighted equally at 25% each: SLA (minimise delay), Cost (minimise monetary cost), Quantity (minimise shortfall), and Inventory (minimise depletion). Scores are min-max normalised across the Full candidate set.</rdfs:comment>
    <ont:icon>🎯</ont:icon>
    <ont:color>#795548</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/goal_goalId">
    <rdfs:label>goalId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Goal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Goal identifier (G-SLA, G-COST, G-QTY, G-INV)</rdfs:comment>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/goal_name">
    <rdfs:label>name</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Goal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/goal_weight">
    <rdfs:label>weight</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Goal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Scoring weight (0.25 for each of the four goals in the default DMA configuration)</rdfs:comment>
    <ont:propertyType>decimal</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- ── Recommendation ─────────────────────────────────────────────────── -->

  <owl:Class rdf:about="http://microsoft.com/ontology/dma-two-layer/Recommendation">
    <rdfs:label>Recommendation</rdfs:label>
    <rdfs:comment>A strategic supply chain hardening action derived from one or more Reflections. Recommendations surface systemic improvements (e.g. "Qualify Vendor 1001 or 1002 as approved alternates on all single-sourced items") that should be addressed outside the immediate disruption response.</rdfs:comment>
    <ont:icon>📌</ont:icon>
    <ont:color>#E91E63</ont:color>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/recommendation_recId">
    <rdfs:label>recId</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Recommendation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/recommendation_body">
    <rdfs:label>body</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Recommendation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/recommendation_priority">
    <rdfs:label>priority</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Recommendation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>enum</ont:propertyType>
    <ont:enumValues>High,Medium,Low</ont:enumValues>
  </owl:DatatypeProperty>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- LAYER 1 RELATIONSHIPS                                                   -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/vendor_supplies_purchaseorderline">
    <rdfs:label>supplies</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine"/>
    <rdfs:comment>A vendor is the named supplier on a purchase order line</rdfs:comment>
    <ont:cardinality>one-to-many</ont:cardinality>
    <ont:fromEntityId>vendor</ont:fromEntityId>
    <ont:toEntityId>purchaseorderline</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/purchaseorderline_delivers_item">
    <rdfs:label>delivers</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:comment>A purchase order line delivers a specific item</rdfs:comment>
    <ont:cardinality>many-to-one</ont:cardinality>
    <ont:fromEntityId>purchaseorderline</ont:fromEntityId>
    <ont:toEntityId>item</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/item_substitutes_for_item">
    <rdfs:label>substitutes for</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:comment>An approved alternate item that can replace the disrupted item (ReleasedProductsV2.AlternativeItemNumber)</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>item</ont:fromEntityId>
    <ont:toEntityId>item</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/item_stocked_at_inventory">
    <rdfs:label>stocked at</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Inventory"/>
    <rdfs:comment>An item has on-hand inventory at one or more warehouse locations</rdfs:comment>
    <ont:cardinality>one-to-many</ont:cardinality>
    <ont:fromEntityId>item</ont:fromEntityId>
    <ont:toEntityId>inventory</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/purchaseorderline_pegged_to_salesorder">
    <rdfs:label>pegged to</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/SalesOrder"/>
    <rdfs:comment>A purchase order line is demand-matched (Marking or Pegged) to a downstream sales order</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>purchaseorderline</ont:fromEntityId>
    <ont:toEntityId>salesorder</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/salesorder_allocated_to_customer">
    <rdfs:label>allocated to</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/SalesOrder"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Customer"/>
    <rdfs:comment>A sales order fulfils a commitment to a specific customer</rdfs:comment>
    <ont:cardinality>many-to-one</ont:cardinality>
    <ont:fromEntityId>salesorder</ont:fromEntityId>
    <ont:toEntityId>customer</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/vendor_has_tradeagreement">
    <rdfs:label>has trade agreement</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/TradeAgreement"/>
    <rdfs:comment>A vendor has a PurchasePriceAgreement for one or more items defining price, fixed charges, and lead time</rdfs:comment>
    <ont:cardinality>one-to-many</ont:cardinality>
    <ont:fromEntityId>vendor</ont:fromEntityId>
    <ont:toEntityId>tradeagreement</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/item_covered_by_tradeagreement">
    <rdfs:label>covered by</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/TradeAgreement"/>
    <rdfs:comment>An item is priced by one or more vendor trade agreements (PurchasePriceAgreements)</rdfs:comment>
    <ont:cardinality>one-to-many</ont:cardinality>
    <ont:fromEntityId>item</ont:fromEntityId>
    <ont:toEntityId>tradeagreement</ont:toEntityId>
  </owl:ObjectProperty>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- LAYER 2 RELATIONSHIPS                                                   -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/episode_next_episode">
    <rdfs:label>NEXT</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:comment>Temporal succession — this episode immediately precedes the next in the disruption history chain</rdfs:comment>
    <ont:cardinality>one-to-one</ont:cardinality>
    <ont:fromEntityId>episode</ont:fromEntityId>
    <ont:toEntityId>episode</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/episode_has_concept">
    <rdfs:label>HAS_CONCEPT</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Concept"/>
    <rdfs:comment>Tags an episode with one or more thematic concepts for concept-mediated retrieval across episodes</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>episode</ont:fromEntityId>
    <ont:toEntityId>concept</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_derived_from_episode">
    <rdfs:label>DERIVED_FROM</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:comment>A mitigation decision was evaluated as part of this episode's resolution</rdfs:comment>
    <ont:cardinality>many-to-one</ont:cardinality>
    <ont:fromEntityId>mitigationdecision</ont:fromEntityId>
    <ont:toEntityId>episode</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/fact_derived_from_episode">
    <rdfs:label>DERIVED_FROM</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Fact"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:comment>An LLM distilled this fact from one or more disruption episodes</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>fact</ont:fromEntityId>
    <ont:toEntityId>episode</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/reflection_derived_from_fact">
    <rdfs:label>DERIVED_FROM_FACT</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Reflection"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Fact"/>
    <rdfs:comment>A reflection synthesises a higher-order pattern from one or more atomic facts</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>reflection</ont:fromEntityId>
    <ont:toEntityId>fact</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/fact_about_concept">
    <rdfs:label>ABOUT_CONCEPT</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Fact"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Concept"/>
    <rdfs:comment>Tags a fact to one or more thematic concepts, enabling cross-item retrieval by concept</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>fact</ont:fromEntityId>
    <ont:toEntityId>concept</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_governed_by_policy">
    <rdfs:label>GOVERNED_BY</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Policy"/>
    <rdfs:comment>Records which business rules constrained or eliminated this mitigation option</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>mitigationdecision</ont:fromEntityId>
    <ont:toEntityId>policy</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_scored_against_goal">
    <rdfs:label>SCORED_AGAINST</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Goal"/>
    <rdfs:comment>Full mitigation decisions are scored against the four weighted goals (SLA, Cost, Qty, Inventory)</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>mitigationdecision</ont:fromEntityId>
    <ont:toEntityId>goal</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/recommendation_supported_by_reflection">
    <rdfs:label>SUPPORTED_BY</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Recommendation"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Reflection"/>
    <rdfs:comment>A strategic recommendation is grounded in one or more reflections that identify the systemic risk it addresses</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>recommendation</ont:fromEntityId>
    <ont:toEntityId>reflection</ont:toEntityId>
  </owl:ObjectProperty>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- CROSS-LAYER RELATIONSHIPS (Intelligence → Supply Chain anchors)         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/episode_concerns_vendor">
    <rdfs:label>CONCERNS (Vendor)</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:comment>Cross-layer anchor: this episode involves the specified vendor as the disruption source. Primary retrieval path — when a disruption fires on a vendor, all episodes with CONCERNS edges to that vendor are loaded into agent context.</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>episode</ont:fromEntityId>
    <ont:toEntityId>vendor</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/episode_concerns_item">
    <rdfs:label>CONCERNS (Item)</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:comment>Cross-layer anchor: this episode involves the specified item as the disrupted material. Enables item-scoped retrieval of prior episodes.</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>episode</ont:fromEntityId>
    <ont:toEntityId>item</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/episode_concerns_po">
    <rdfs:label>CONCERNS (PO)</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Episode"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine"/>
    <rdfs:comment>Cross-layer anchor: this episode was triggered by a disruption on the specified purchase order line</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>episode</ont:fromEntityId>
    <ont:toEntityId>purchaseorderline</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/fact_characterizes_vendor">
    <rdfs:label>CHARACTERIZES (Vendor)</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Fact"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:comment>Cross-layer anchor: this fact describes a pattern or behaviour specific to the vendor. Surfaced whenever the DMA queries context for that vendor.</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>fact</ont:fromEntityId>
    <ont:toEntityId>vendor</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/fact_characterizes_item">
    <rdfs:label>CHARACTERIZES (Item)</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Fact"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:comment>Cross-layer anchor: this fact describes a pattern or behaviour specific to the item. Surfaced whenever the DMA queries context for that item.</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>fact</ont:fromEntityId>
    <ont:toEntityId>item</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/reflection_targets_vendor">
    <rdfs:label>TARGETS (Vendor)</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Reflection"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:comment>Cross-layer anchor: this reflection identifies a systemic issue centred on the specified vendor</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>reflection</ont:fromEntityId>
    <ont:toEntityId>vendor</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/reflection_targets_item">
    <rdfs:label>TARGETS (Item)</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Reflection"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Item"/>
    <rdfs:comment>Cross-layer anchor: this reflection identifies a systemic issue centred on the specified item</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>reflection</ont:fromEntityId>
    <ont:toEntityId>item</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/recommendation_targets_vendor">
    <rdfs:label>TARGETS (Vendor)</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/Recommendation"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/Vendor"/>
    <rdfs:comment>Cross-layer anchor: this recommendation is directed at a specific vendor relationship</rdfs:comment>
    <ont:cardinality>many-to-many</ont:cardinality>
    <ont:fromEntityId>recommendation</ont:fromEntityId>
    <ont:toEntityId>vendor</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://microsoft.com/ontology/dma-two-layer/mitigationdecision_resolved_po">
    <rdfs:label>RESOLVED</rdfs:label>
    <rdfs:domain rdf:resource="http://microsoft.com/ontology/dma-two-layer/MitigationDecision"/>
    <rdfs:range rdf:resource="http://microsoft.com/ontology/dma-two-layer/PurchaseOrderLine"/>
    <rdfs:comment>Cross-layer anchor: the rank-1 Full decision that was selected to resolve the disrupted purchase order. Permanently records which mitigation was actually applied.</rdfs:comment>
    <ont:cardinality>many-to-one</ont:cardinality>
    <ont:fromEntityId>mitigationdecision</ont:fromEntityId>
    <ont:toEntityId>purchaseorderline</ont:toEntityId>
  </owl:ObjectProperty>

</rdf:RDF>
